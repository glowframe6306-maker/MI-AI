rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to verify user ownership
    function owns(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isMember(ownerId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/owners/$(ownerId)/members/$(request.auth.uid)).data.state == 'active';
    }
    
    // User root documents
    match /users/{uid} {
      allow read, create, update, delete: if owns(uid);
      
      // User settings subcollection
      match /settings/{document=**} {
        allow read, create, update, delete: if owns(uid);
      }

      // Permanent account memory is private to the authenticated account.
      match /memories/{memoryId} {
        allow read, create, update, delete: if owns(uid);
      }
      
      // User chats subcollection
      match /chats/{chatId} {
        // Allow read/write only if user owns this chat
        allow read, create, update, delete: if owns(uid) && 
          (resource.data.userId == uid || request.resource.data.userId == uid);
        
        // Messages subcollection within each chat
        match /messages/{messageId} {
          // Allow read/write only if user owns the parent chat
          allow read, create, update, delete: if owns(uid) && 
            get(/databases/$(database)/documents/users/$(uid)/chats/$(chatId)).data.userId == uid;
        }
      }
    }

    // Shared owner data is available only to explicitly linked active members.
    match /owners/{ownerId} {
      allow read: if isMember(ownerId);
      allow create, update, delete: if false;

      match /members/{memberUid} {
        allow read: if isMember(ownerId) && request.auth.uid == memberUid;
        allow write: if false;
      }

      match /chats/{chatId} {
        allow read, create, update: if isMember(ownerId) &&
          request.resource.data.ownerId == ownerId;
        allow delete: if isMember(ownerId) &&
          resource.data.ownerId == ownerId;

        match /messages/{messageId} {
          allow read, create, update: if isMember(ownerId) &&
            get(/databases/$(database)/documents/owners/$(ownerId)/chats/$(chatId)).data.ownerId == ownerId;
          allow delete: if false;
        }
      }

      match /settings/{settingId} {
        allow read, create, update: if isMember(ownerId) &&
          request.resource.data.updatedBy == request.auth.uid;
        allow delete: if false;
      }

      match /invitations/{inviteId} {
        allow read, write: if false;
      }
    }
    
    // Default deny for other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
